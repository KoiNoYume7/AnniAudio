<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
   <ViewDefinitions>
      <View>
         <Name>AudioDeviceInfo</Name>
         <ViewSelectedBy>
            <TypeName>MartinGC94.AudioConfig.API.AudioDevice</TypeName>
         </ViewSelectedBy>
         <TableControl>
            <TableHeaders>

               <TableColumnHeader>
                  <Label>Name</Label>
                  <Width>17</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>DeviceName</Label>
                  <Width>30</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>DeviceType</Label>
                  <Width>10</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>FormFactor</Label>
                  <Width>14</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>State</Label>
                  <Width>10</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>Muted</Label>
                  <Width>5</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>VolumeLevel</Label>
                  <Width>11</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

            </TableHeaders>
            <TableRowEntries>
               <TableRowEntry>
                  <TableColumnItems>

                     <TableColumnItem>
                        <PropertyName>Name</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>DeviceName</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>DeviceType</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>FormFactor</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>State</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>Muted</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>VolumeLevel</PropertyName>
                     </TableColumnItem>

                  </TableColumnItems>
               </TableRowEntry>
            </TableRowEntries>
         </TableControl>
      </View>
      <View>
         <Name>AudioSessionInfo</Name>
         <ViewSelectedBy>
            <TypeName>MartinGC94.AudioConfig.API.AudioSession</TypeName>
         </ViewSelectedBy>
         <TableControl>
            <TableHeaders>

               <TableColumnHeader>
                  <Label>DisplayName</Label>
                  <Width>25</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>ProcessId</Label>
                  <Width>9</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>State</Label>
                  <Width>8</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>VolumeLevel</Label>
                  <Width>11</Width>
                  <Alignment>right</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>Muted</Label>
                  <Width>5</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>InputDeviceId</Label>
                  <Width>15</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

               <TableColumnHeader>
                  <Label>OutputDeviceId</Label>
                  <Width>15</Width>
                  <Alignment>left</Alignment>
               </TableColumnHeader>

            </TableHeaders>
            <TableRowEntries>
               <TableRowEntry>
                  <TableColumnItems>

                     <TableColumnItem>
                        <PropertyName>DisplayName</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>ProcessId</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>State</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>VolumeLevel</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>Muted</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>InputDeviceId</PropertyName>
                     </TableColumnItem>

                     <TableColumnItem>
                        <PropertyName>OutputDeviceId</PropertyName>
                     </TableColumnItem>

                  </TableColumnItems>
               </TableRowEntry>
            </TableRowEntries>
         </TableControl>
      </View>
   </ViewDefinitions>
</Configuration>