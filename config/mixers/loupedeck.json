{
  "description": "6-strip mixer for Loupedeck Live control: VAC sources mixed to the Logitech G560. Knob binding is done by the Loupedeck plugin via the mixer control API, not in this file.",
  "output": "Logitech G560 Gaming Speaker",
  "master": 80,
  "strips": [
    { "name": "Game",  "source": "Game (Virtual Audio Cable)",  "volume": 100 },
    { "name": "Music", "source": "Music (Virtual Audio Cable)", "volume": 80 },
    { "name": "Chat",  "source": "Chat (Virtual Audio Cable)",  "volume": 80 },
    { "name": "Ext",   "source": "Ext (Virtual Audio Cable)",   "volume": 60 },
    { "name": "System","source": "System (Virtual Audio Cable)","volume": 70 },
    { "name": "Mic",   "source": "Mic (Virtual Audio Cable)",   "volume": 0, "muted": true }
  ]
}
